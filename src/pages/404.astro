---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout currentPage="project" title="Page not found — Dita Suhito" description="This page is not available.">
  <main id="main" class="not-found">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>This page isn’t here.</h1>
    <p>The link may be out of date, or the page may have moved.</p>
    <a class="button button--primary" href="/">Return to portfolio <span aria-hidden="true">↗</span></a>
  </main>
</SiteLayout>
