---
import { site } from "../data/site";
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-section__inner">
    <p class="eyebrow">04 / CONTACT</p>
    <h2 id="contact-title">Let’s talk iOS.</h2>
    <p>Find me on GitHub for the work I share publicly.</p>
    <a class="button button--primary" href={site.github.href} rel="me noopener noreferrer">
      Visit GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
